<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ SplashScreen icon.

    The Android 12 SplashScreen API expects the animated icon to look like
    an adaptive icon (108dp canvas, brand mark inside the 66dp visible
    safe zone). When a plain vector drawable is used instead, several
    OEMs (Samsung, Xiaomi) draw a default dark circular/square icon
    plate behind the mark — that plate is what appeared as an opaque
    black square around the Irth logo during cold start.

    Declaring the splash icon as an adaptive-icon with a fully
    transparent background eliminates the plate: only the already-inset
    `ic_launcher_foreground` mark is drawn on top of the navy
    `windowSplashScreenBackground`. Do NOT set an opaque background
    here and do NOT set `windowSplashScreenIconBackgroundColor` in the
    launch theme — either would reintroduce the plate.

    Regenerated by scripts/generate-android-branding.mjs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
