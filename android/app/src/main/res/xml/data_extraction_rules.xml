<?xml version="1.0" encoding="utf-8"?>
<!--
  Disable cloud backup and device-to-device transfer of app data on
  Android 12+. Combined with android:allowBackup="false" and
  android:fullBackupContent="false" this prevents WebView localStorage
  (onboarding flag, first-launch choice, etc.) from being restored on
  reinstall, which was causing "fresh installs" to appear already
  onboarded and to skip the auth-choice dialog.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
