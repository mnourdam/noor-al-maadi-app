<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
        Cold-start theme. Uses the Android 12+ SplashScreen API (the AndroidX
        core-splashscreen library back-ports it to API 24+). The brand icon is
        the canonical transparent foreground vector so it never carries a baked
        black/navy plate; the background remains this theme color only.
        The post-splash theme then transitions into the cinematic React splash
        already shipped with the app — this layer only owns the OS hand-off.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!--
            Dedicated splash-only vector (transparent, gold Irth mark
            filling ~96dp of the 108dp canvas). We deliberately do NOT
            reuse @drawable/ic_launcher_foreground here because that vector
            is scaled to the adaptive-icon 66dp safe zone, which the
            SplashScreen API then re-frames inside its own 240dp/192dp icon
            window — producing a boxed app-icon plate on the cold-start
            frame. Launcher icons continue to use ic_launcher_foreground
            and remain unchanged.
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <!--
            Intentionally NO `windowSplashScreenIconBackgroundColor`.
            Setting it forces Android to draw an extra plate behind the
            icon, which reads as a rounded-square launcher shape during the
            cold-start frame.
        -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
