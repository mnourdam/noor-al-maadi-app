{
  "name": "irth",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run snapshot:ensure && vite build",
    "build:dev": "npm run snapshot:ensure && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "snapshot:generate": "node scripts/generate-offline-snapshot.mjs",
    "snapshot:ensure": "node scripts/ensure-offline-snapshot.mjs",
    "verify:offline-snapshot": "node scripts/verify-offline-snapshot.mjs pre",
    "verify:offline-snapshot:post": "node scripts/verify-offline-snapshot.mjs post",
    "verify:campaign-intros": "node --experimental-strip-types scripts/verify-campaign-intro-assets.mjs",
    "build:android:web": "npm run snapshot:generate && npm run snapshot:ensure && npm run verify:offline-snapshot && npm run verify:campaign-intros && vite build --config vite.android.config.ts && node scripts/finalize-android.mjs",
    "sync:android": "npm run build:android:web && node scripts/generate-android-branding.mjs && npx cap sync android && npm run verify:offline-snapshot:post",
    "open:android": "npx cap open android",
    "apk:debug": "npm run sync:android && node scripts/run-android-gradle.mjs",
    "check:economy-parity": "node scripts/check-economy-parity.mjs",
    "test:daily-challenge-scheduler": "node --import tsx scripts/test-daily-challenge-scheduler.mjs",
    "test:answer-matching": "node --experimental-strip-types scripts/test-arabic-answer-matching.mjs"
  },
